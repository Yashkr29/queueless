# ---- Database: Supabase Postgres connection string (Project Settings > Database > Connection string)
# Leave unset to use a local SQLite file for development/tests.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Security (REQUIRED outside local SQLite). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20

# ---- Behaviour
DEMO_MODE=true            # include is_demo rows in analytics; set false for real pilots
ML_ENABLED=true           # false forces the labelled non-ML fallback
AUTO_CREATE_TABLES=false  # keep false on Supabase; the SQL migration is authoritative
# DEMO_PASSWORD=Demo@12345  # password used by scripts/seed_demo.py for demo accounts

# ---- Optional push notifications (Firebase service-account JSON path)
FCM_CREDENTIALS_FILE=
